{
	"name": "cat-clapping",
	"displayName": "Cat clapping",
	"description": "Cat clapping meme",
	"publisher": "nicosmartworking",
	"version": "0.0.7",
	"engines": {
		"vscode": "^1.131.0"
	},
	"categories": [
		"Other"
	],
	"contributes": {
		"configuration": {
			"title": "Cat Clapping",
			"properties": {
				"catClapping.enabledCommands": {
					"type": "array",
					"scope": "resource",
					"default": [
						"*"
					],
					"items": {
						"type": "string"
					},
					"markdownDescription": "Commands that trigger the cat after a successful run. `[\"*\"]` keeps the built-in build and run detection. Set entries such as `npm`, `python` (also matches `py` and `python3`), `node`, `myapp.exe`, or `executable`. Use `tasks` for tasks without a recognized command and `debug` for all debug sessions. An empty list disables celebrations. Changes apply immediately."
				}
			}
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"icon": "media/icon.png",
	"keywords": [
		"build",
		"compile",
		"cat",
		"meme",
		"celebration",
		"fun"
	],
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/vscode": "^1.131.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"typescript-eslint": "^8.61.1",
		"eslint": "^10.5.0",
		"typescript": "^6.0.3",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	}
}
